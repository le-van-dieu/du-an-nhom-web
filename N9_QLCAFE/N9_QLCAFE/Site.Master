<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.Master.cs" Inherits="N9_QLCAFE.SiteMaster" %>
<!DOCTYPE html>
<html lang="vi">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%: Page.Title %> - MOON CAFÉ Management</title>
    <!-- Google Fonts for Vietnamese Typography -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link href="~/Content/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link href="~/Content/site.css" rel="stylesheet" />
    <asp:ContentPlaceHolder ID="HeadContent" runat="server" />
</head>
<body>
    <form id="form1" runat="server" enctype="multipart/form-data">
        <div class="app-wrapper">
            <!-- SIDEBAR ĐIỀU HƯỚNG CHÍNH -->
            <aside class="app-sidebar">
                <a href="Default.aspx" class="sidebar-brand">
                    <div class="brand-icon">
                        <img src="Content/moon-logo.svg" alt="MOON CAFÉ Logo" />
                    </div>
                    <div class="brand-text">
                        <h5>MOON CAFÉ</h5>
                        <span>Hệ thống Quản lý Quán Café</span>
                    </div>
                </a>

                <div class="sidebar-menu">
                    <div class="menu-label">Tổng quan & Báo cáo</div>
                    <a href="Default.aspx" class="sidebar-link <%= Request.Url.AbsolutePath.EndsWith("Default.aspx") || Request.Url.AbsolutePath == "/" ? "active" : "" %>">
                        <i class="bi bi-bar-chart-line-fill"></i>
                        <span>Thống kê & Doanh thu</span>
                    </a>

                    <div class="menu-label mt-2">Nghiệp vụ Bán hàng</div>
                    <a href="GoiMonThanhToan.aspx" class="sidebar-link <%= Request.Url.AbsolutePath.EndsWith("GoiMonThanhToan.aspx") ? "active" : "" %>">
                        <i class="bi bi-cart-check-fill"></i>
                        <span>Gọi món & Thanh toán</span>
                    </a>
                    <a href="BanVaDatBan.aspx" class="sidebar-link <%= Request.Url.AbsolutePath.EndsWith("BanVaDatBan.aspx") ? "active" : "" %>">
                        <i class="bi bi-grid-3x3-gap-fill"></i>
                        <span>Quản lý Bàn & Đặt bàn</span>
                    </a>

                    <div class="menu-label mt-2">Quản trị Danh mục</div>
                    <a href="DoUong.aspx" class="sidebar-link <%= Request.Url.AbsolutePath.EndsWith("DoUong.aspx") ? "active" : "" %>">
                        <i class="bi bi-cup-straw"></i>
                        <span>Đồ uống & Menu</span>
                    </a>
                    <a href="NhanVienTaiKhoan.aspx" class="sidebar-link <%= Request.Url.AbsolutePath.EndsWith("NhanVienTaiKhoan.aspx") ? "active" : "" %>">
                        <i class="bi bi-people-fill"></i>
                        <span>Nhân viên & Tài khoản</span>
                    </a>
                    <a href="KhachHang.aspx" class="sidebar-link <%= Request.Url.AbsolutePath.EndsWith("KhachHang.aspx") ? "active" : "" %>">
                        <i class="bi bi-person-hearts"></i>
                        <span>Quản lý Khách hàng</span>
                    </a>

                    <div class="menu-label mt-2">Hệ thống & Kiểm thử</div>
                    <a href="KiemThuNghiemThu.aspx" class="sidebar-link <%= Request.Url.AbsolutePath.EndsWith("KiemThuNghiemThu.aspx") ? "active" : "" %>">
                        <i class="bi bi-clipboard2-check-fill"></i>
                        <span>Kiểm thử & Nghiệm thu</span>
                    </a>
                    <a href="Login.aspx" class="sidebar-link">
                        <i class="bi bi-box-arrow-in-right"></i>
                        <span>Trang Đăng nhập (F01)</span>
                    </a>
                </div>

                <div class="sidebar-footer">
                    <div class="d-flex align-items-center justify-content-between">
                        <div class="small">
                            <div class="fw-semibold text-white">Nhóm 9 - WebForms</div>
                            <div style="font-size: 0.72rem; color: #bfdbfe;">MySQL • ASP.NET 4.7.2</div>
                        </div>
                        <span class="badge bg-light text-primary fw-bold">v1.0</span>
                    </div>
                </div>
            </aside>

            <!-- KHU VỰC NỘI DUNG CHÍNH -->
            <div class="app-main">
                <!-- TOPBAR -->
                <header class="app-topbar">
                    <div class="d-flex align-items-center gap-3">
                        <div class="input-group input-group-sm" style="width: 310px;">
                            <span class="input-group-text bg-light border-end-0 text-primary">
                                <i class="bi bi-search"></i>
                            </span>
                            <input type="text" class="form-control bg-light border-start-0" placeholder="Tìm nhanh món, mã bàn, mã hóa đơn..." />
                        </div>
                        <span class="badge badge-soft-blue d-none d-md-inline-flex align-items-center gap-1">
                            <i class="bi bi-clock-history"></i> Ca sáng: 07:00 - 15:00
                        </span>
                    </div>

                    <div class="d-flex align-items-center gap-3">
                        <a href="GoiMonThanhToan.aspx" class="btn btn-sm btn-cafe-primary d-none d-sm-inline-flex align-items-center gap-1">
                            <i class="bi bi-plus-circle"></i> Tạo đơn mới (F27)
                        </a>

                        <!-- Thông tin tài khoản & Phân quyền (F01 - F04) -->
                        <div class="dropdown">
                            <button class="btn btn-light border d-flex align-items-center gap-2 py-1 px-2 rounded-3 dropdown-toggle" type="button" data-bs-toggle="dropdown">
                                <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center fw-bold" style="width: 32px; height: 32px; font-size: 0.85rem;">
                                    N9
                                </div>
                                <div class="text-start d-none d-sm-block" style="line-height: 1.15;">
                                    <div class="fw-semibold small text-dark">Quản trị viên (Admin)</div>
                                    <span class="text-primary" style="font-size: 0.72rem;">Toàn quyền hệ thống</span>
                                </div>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0 mt-2">
                                <li class="px-3 py-2 border-bottom">
                                    <div class="fw-semibold small">Tài khoản: admin_nhom9</div>
                                    <div class="text-muted" style="font-size: 0.75rem;">Vai trò: Admin / Quản lý</div>
                                </li>
                                <li>
                                    <a class="dropdown-item py-2 small" href="#" data-bs-toggle="modal" data-bs-target="#modalDoiMatKhau">
                                        <i class="bi bi-key me-2 text-primary"></i>Đổi mật khẩu (F03)
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item py-2 small" href="NhanVienTaiKhoan.aspx">
                                        <i class="bi bi-shield-lock me-2 text-primary"></i>Phân quyền hệ thống (F04)
                                    </a>
                                </li>
                                <li><hr class="dropdown-divider" /></li>
                                <li>
                                    <a class="dropdown-item py-2 small text-danger" href="Login.aspx">
                                        <i class="bi bi-box-arrow-right me-2"></i>Đăng xuất (F02)
                                    </a>
                                </li>
                            </ul>
                        </div>
                    </div>
                </header>

                <!-- NỘI DUNG TỪNG TRANG -->
                <main class="app-content">
                    <asp:ContentPlaceHolder ID="MainContent" runat="server" />
                </main>

                <!-- FOOTER -->
                <footer class="bg-white border-top py-3 px-4 text-muted small d-flex flex-wrap justify-content-between align-items-center">
                    <div>
                        <strong class="text-primary">MOON CAFÉ - Quản lý cửa hàng Café</strong> • Thành viên: Nguyễn Nhật Anh, Nguyễn Anh Kỳ, Lư Quốc Thắng, Lê Văn Điều, Mẫn Vinh.
                    </div>
                    <div>
                        Hệ thống Quản lý Quán Café (MOON CAFÉ)
                    </div>
                </footer>
            </div>
        </div>

        <!-- MODAL ĐỔI MẬT KHẨU (F03) -->
        <div class="modal fade" id="modalDoiMatKhau" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content border-0 shadow">
                    <div class="modal-header bg-primary text-white">
                        <h6 class="modal-title fw-bold"><i class="bi bi-shield-lock me-2"></i>Đổi mật khẩu tài khoản (F03)</h6>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body p-4">
                        <div class="mb-3">
                            <label class="form-label small fw-semibold">Tên đăng nhập</label>
                            <input type="text" class="form-control bg-light" placeholder="Nhập tên đăng nhập..." />
                        </div>
                        <div class="mb-3">
                            <label class="form-label small fw-semibold">Mật khẩu hiện tại <span class="text-danger">*</span></label>
                            <input type="password" class="form-control" placeholder="Nhập mật khẩu hiện tại..." />
                        </div>
                        <div class="mb-3">
                            <label class="form-label small fw-semibold">Mật khẩu mới <span class="text-danger">*</span></label>
                            <input type="password" class="form-control" placeholder="Tối thiểu 6 ký tự..." />
                        </div>
                        <div class="mb-0">
                            <label class="form-label small fw-semibold">Xác nhận mật khẩu mới <span class="text-danger">*</span></label>
                            <input type="password" class="form-control" placeholder="Nhập lại mật khẩu mới..." />
                        </div>
                    </div>
                    <div class="modal-footer bg-light">
                        <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Đóng</button>
                        <button type="button" class="btn btn-sm btn-cafe-primary" data-bs-dismiss="modal">Lưu mật khẩu mới</button>
                    </div>
                </div>
            </div>
        </div>

        <script src="Scripts/bootstrap.bundle.min.js"></script>
    </form>
</body>
</html>
