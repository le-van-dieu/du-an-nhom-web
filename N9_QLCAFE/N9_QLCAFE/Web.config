<?xml version="1.0" encoding="utf-8"?>
<configuration>
	<!-- BỔ SUNG ĐOẠN NÀY VÀO -->
	<connectionStrings>
		<add name="quanlyquancafeConnectionString"
			 connectionString="Data Source=.\SQLEXPRESS;Initial Catalog=quanlyquancafe;Integrated Security=True"
			 providerName="System.Data.SqlClient" />
	</connectionStrings>

	<system.web>
		<compilation debug="true" targetFramework="4.7.2" />
		<httpRuntime targetFramework="4.7.2" />
		<globalization fileEncoding="utf-8" requestEncoding="utf-8" responseEncoding="utf-8" culture="vi-VN" uiCulture="vi-VN" />
	</system.web>
</configuration>
